{
  "name": "reunite-lost-and-found",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A MERN campus lost and found board built through AI-assisted iteration.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/demo.js",
    "demo": "node scripts/demo.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "dev:persistent": "concurrently -k -n api,web \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --config client/vite.config.js\""
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.77.0",
    "mongoose": "9.12.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2",
    "vite": "8.3.8"
  }
}
